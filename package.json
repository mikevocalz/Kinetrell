{
  "name": "kinetrell",
  "version": "0.1.0-alpha.1",
  "description": "One motion language for React Native Reanimated, GSAP, and Lenis.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js"
    },
    "./compat/gsap": {
      "types": "./dist/compat/gsap.d.ts",
      "import": "./dist/compat/gsap.js"
    },
    "./web/gsap": {
      "types": "./dist/web/gsap.d.ts",
      "import": "./dist/web/gsap.js"
    },
    "./web/lenis": {
      "types": "./dist/web/lenis.d.ts",
      "import": "./dist/web/lenis.js"
    },
    "./web/gsap-lenis": {
      "types": "./dist/web/gsap-lenis.d.ts",
      "import": "./dist/web/gsap-lenis.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:current": "node scripts/audit-current-npm.mjs",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run typecheck && npm run test && npm run build && npm run pack:check",
    "verify:expo58": "npm --workspace @kinetrell/example-expo58 run typecheck"
  },
  "peerDependencies": {
    "@gsap/react": ">=2.1.2 <3",
    "gsap": ">=3.15.0 <4",
    "lenis": ">=1.3.26 <2",
    "react": ">=19.0.0 <20",
    "react-native": ">=0.86.0 <0.89",
    "react-native-reanimated": ">=4.7.0 <5",
    "react-native-worklets": ">=0.13.0 <0.14"
  },
  "peerDependenciesMeta": {
    "@gsap/react": { "optional": true },
    "gsap": { "optional": true },
    "lenis": { "optional": true },
    "react": { "optional": true },
    "react-native": { "optional": true },
    "react-native-reanimated": { "optional": true },
    "react-native-worklets": { "optional": true }
  },
  "devDependencies": {
    "@gsap/react": "2.1.2",
    "@types/react": "19.3.0",
    "expo": "58.0.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "react": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-gesture-handler": "3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-worklets": "0.13.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "react-native",
    "reanimated",
    "animation",
    "timeline",
    "gsap",
    "lenis",
    "scroll"
  ],
  "workspaces": [
    "examples/*"
  ]
}
