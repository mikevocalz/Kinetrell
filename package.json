{
  "name": "kinetrell",
  "version": "0.1.0-alpha.1",
  "description": "One motion language for React Native Reanimated, GSAP, and Lenis.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs"
    },
    "./native": {
      "types": "./dist/native/index.d.mts",
      "import": "./dist/native/index.mjs"
    },
    "./compat/gsap": {
      "types": "./dist/compat/gsap.d.mts",
      "import": "./dist/compat/gsap.mjs"
    },
    "./web/gsap": {
      "types": "./dist/web/gsap.d.mts",
      "import": "./dist/web/gsap.mjs"
    },
    "./web/lenis": {
      "types": "./dist/web/lenis.d.mts",
      "import": "./dist/web/lenis.mjs"
    },
    "./web/gsap-lenis": {
      "types": "./dist/web/gsap-lenis.d.mts",
      "import": "./dist/web/gsap-lenis.mjs"
    },
    "./native/gesture": {
      "types": "./dist/native/gesture.d.mts",
      "import": "./dist/native/gesture.mjs"
    },
    "./core/diagnostics": {
      "types": "./dist/core/diagnostics.d.mts",
      "import": "./dist/core/diagnostics.mjs"
    },
    "./dev/inspector": {
      "types": "./dist/dev/inspector.d.mts",
      "import": "./dist/dev/inspector.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:current": "node scripts/audit-current-npm.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:package": "node scripts/check-package.mjs",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run typecheck && npm run test && npm run build && npm run check:boundaries && npm run check:package && npm run pack:check",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "@gsap/react": ">=2.1.2 <3",
    "gsap": ">=3.15.0 <4",
    "lenis": ">=1.3.26 <2",
    "react": ">=19.0.0 <20",
    "react-native": ">=0.86.0-0 <0.89.0-0",
    "react-native-reanimated": ">=4.7.0 <5",
    "react-native-worklets": ">=0.13.0 <0.14",
    "react-native-gesture-handler": ">=3.2.1 <4"
  },
  "peerDependenciesMeta": {
    "@gsap/react": {
      "optional": true
    },
    "gsap": {
      "optional": true
    },
    "lenis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gsap/react": "2.1.2",
    "@types/react": "19.3.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "3.2.1",
    "react-native-reanimated": "4.7.0",
    "react-native-worklets": "0.13.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "react-native",
    "reanimated",
    "animation",
    "timeline",
    "gsap",
    "lenis",
    "scroll"
  ]
}
